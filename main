    <!-- СКРИПТЫ -->
    <script>
        // Иконки для стройматериалов и отделки
        const availableIcons = [
            { val: 'fas fa-trowel', name: 'Штукатурка / Шпаклевка' },
            { val: 'fas fa-paint-roller', name: 'Малярные работы / Краска' },
            { val: 'fas fa-fill-drip', name: 'Декоративная штукатурка' },
            { val: 'fas fa-border-all', name: 'Плитка / Керамогранит' },
            { val: 'fas fa-layer-group', name: 'Ламинат / Напольные покрытия' },
            { val: 'fas fa-tape', name: 'Расходники / Скотч / Пленка' },
            { val: 'fas fa-pallet', name: 'Сухие смеси / Мешки / Поддоны' },
            { val: 'fas fa-box-open', name: 'Прочие материалы' },
            { val: 'fas fa-truck', name: 'Доставка / Подъем материала' },
            { val: 'fas fa-tools', name: 'Инструмент / Монтаж' }
        ];

        let items = [];

        // --- ЛОГИКА ПОЗИЦИЙ ---
        function formatNumber(num) { return new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num); }

        function handleImageUpload(input, index) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    items[index].imageBase64 = e.target.result;
                    updatePreview();
                };
                reader.readAsDataURL(file);
            }
        }

        function updateItemData(index, field, value) {
            if (field === 'qty' || field === 'price') items[index][field] = parseFloat(value.replace(',', '.')) || 0;
            else items[index][field] = value;
            
            if (field === 'visualType') renderForm();
            else updatePreview();
        }

        function removeItem(index) {
            items.splice(index, 1);
            renderForm();
            updatePreview();
        }

        function addItem(type = 'icon', iconClass = 'fas fa-trowel', desc = 'Новая позиция', price = 1000) {
            items.push({ visualType: type, iconClass: iconClass, imageBase64: '', desc: desc, qty: 1, price: price });
            renderForm();
            updatePreview();
        }

        function renderForm() {
            const container = document.getElementById('items-container');
            container.innerHTML = ''; 

            items.forEach((item, index) => {
                let visualControlHTML = '';
                if (item.visualType === 'image') {
                    visualControlHTML = `<input type="file" accept="image/*" onchange="handleImageUpload(this, ${index})" style="margin-top:5px;">`;
                } else {
                    visualControlHTML = `<select onchange="updateItemData(${index}, 'iconClass', this.value)" style="margin-top:5px;">
                            ${availableIcons.map(ic => `<option value="${ic.val}" ${item.iconClass === ic.val ? 'selected' : ''}>${ic.name}</option>`).join('')}
                        </select>`;
                }

                const div = document.createElement('div');
                div.className = 'item-input-block';
                div.innerHTML = `
                    <button class="remove-btn" onclick="removeItem(${index})" title="Удалить"><i class="fas fa-times"></i></button>
                    
                    <div class="form-group" style="padding-right: 30px;">
                        <label>Изображение или иконка</label>
                        <select onchange="updateItemData(${index}, 'visualType', this.value)">
                            <option value="icon" ${item.visualType === 'icon' ? 'selected' : ''}>Векторная иконка</option>
                            <option value="image" ${item.visualType === 'image' ? 'selected' : ''}>Загрузить картинку</option>
                        </select>
                        ${visualControlHTML}
                    </div>
                    
                    <div class="form-group">
                        <label>Описание материала / работ</label>
                        <input type="text" value="${item.desc}" oninput="updateItemData(${index}, 'desc', this.value)">
                    </div>
                    
                    <div style="display:flex; gap: 10px;">
                        <div class="form-group" style="flex:1;"><label>Кол-во</label><input type="number" step="0.01" value="${item.qty}" oninput="updateItemData(${index}, 'qty', this.value)"></div>
                        <div class="form-group" style="flex:2;"><label>Цена за ед. (₽)</label><input type="number" step="1" value="${item.price}" oninput="updateItemData(${index}, 'price', this.value)"></div>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function updatePreview() {
            // Бренд
            document.getElementById('prev-company').innerText = document.getElementById('c-company').value || 'ГЕОМЕТР';
            document.getElementById('prev-sub').innerText = document.getElementById('c-sub').value;
            
            // Заголовки
            document.getElementById('prev-main-title').innerText = document.getElementById('c-main-title').value;
            document.getElementById('prev-sub-title').innerText = document.getElementById('c-sub-title').value;

            // Контакты и О нас
            const mName = document.getElementById('c-name').value;
            const mPhone = document.getElementById('c-phone').value;
            const mEmail = document.getElementById('c-email').value;

            document.getElementById('prev-c-name-top').innerText = mName;
            document.getElementById('prev-c-phone-top').innerText = mPhone;
            document.getElementById('prev-c-email-top').innerText = mEmail;
            
            document.getElementById('prev-c-name-bot').innerText = mName;
            document.getElementById('prev-c-phone-bot').innerText = mPhone;
            document.getElementById('prev-c-email-bot').innerText = mEmail;

            document.getElementById('prev-about').innerText = document.getElementById('c-about').value;

            // Таблица
            const tbody = document.getElementById('prev-items-body');
            tbody.innerHTML = '';
            let grandTotal = 0;

            items.forEach((item) => {
                const sum = item.qty * item.price;
                grandTotal += sum;

                const tr = document.createElement('tr');
                tr.className = 'kp-row';
                
                let visualHTML = '';
                if (item.visualType === 'image') {
                    const src = item.imageBase64 || 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
                    visualHTML = `<img src="${src}" alt="img">`;
                } else {
                    visualHTML = `<i class="${item.iconClass}"></i>`;
                }

                tr.innerHTML = `
                    <td class="visual-cell"><div class="visual-box">${visualHTML}</div></td>
                    <td><strong style="font-weight: 500; font-size:14px; color:#fff;">${item.desc}</strong></td>
                    <td class="right">${item.qty}</td>
                    <td class="right">${formatNumber(item.price)}</td>
                    <td class="right" style="color:#fff; font-weight:500;">${formatNumber(sum)}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('prev-total-sum').innerText = formatNumber(grandTotal);
        }

        // --- ГЕНЕРАЦИЯ МНОГОСТРАНИЧНОГО PDF ---
        function generatePDF() {
            const element = document.getElementById('pdf-content');
            const subTitle = document.getElementById('c-sub-title').value.replace(/[^a-zа-я0-9]/gi, '_');
            
            const opt = {
                margin:       0,
                filename:     `КП_${subTitle}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#151515' },
                // Формат А4 в пикселях с учетом ширины 800px (пропорция 1 : 1.414)
                jsPDF:        { unit: 'px', format: [800, 1131], orientation: 'portrait' },
                // CSS режим разрыва страниц гарантирует, что строки таблицы не будут разрезаны пополам
                pagebreak:    { mode: ['css', 'legacy'] } 
            };

            html2pdf().set(opt).from(element).save();
        }

        // --- ИНИЦИАЛИЗАЦИЯ ---
        window.onload = () => {
            // Тестовые данные для демонстрации
            addItem('icon', 'fas fa-trowel', 'Штукатурка гипсовая Knauf Rotband (30кг)', 520);
            addItem('icon', 'fas fa-paint-roller', 'Комплекс малярных работ (кв.м)', 1200);
            addItem('icon', 'fas fa-tape', 'Малярная лента, укрывочная пленка, расходники', 3500);
            addItem('icon', 'fas fa-truck', 'Доставка, разгрузка и подъем материала', 4000);
            
            renderForm();
            updatePreview();
        };

    </script>
</body>
</html>
