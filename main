            </div>
        </div>

        <div class="settings-block">
            <h3>Контакты и маркетинг</h3>
            <div class="form-group"><label>Менеджер</label><input type="text" id="c-name" value="Михаил Болдок" oninput="updatePreview()"></div>
            <div class="form-group"><label>Телефон</label><input type="text" id="c-phone" value="+7 (996) 316-39-99" oninput="updatePreview()"></div>
            <div class="form-group"><label>Email</label><input type="text" id="c-email" value="nikolaevich.ba@gmail.com" oninput="updatePreview()"></div>
            
            <div class="form-group" style="margin-top:20px;">
                <label>Текст «О нас» (В самом низу документа)</label>
